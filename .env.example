# Market-Neutral Hedge Builder - Environment Variables
# Copy this file to .env and fill in your API keys

# === LLM API Keys ===
# Google Gemini API Key (required for agent orchestration)
GOOGLE_API_KEY=your_google_api_key_here

# === Optional: News & Sentiment ===
# Tavily API Key (optional, for news catalyst guardrail)
TAVILY_API_KEY=your_tavily_api_key_here

# === Market Configuration ===
# Risk-free rate for India (RBI 10Y Bond Yield, default 6.8%)
RISK_FREE_RATE=0.068

# Default benchmark index
DEFAULT_BENCHMARK=^NSEI

# Default capital in INR
DEFAULT_CAPITAL=100000

# === Cache Configuration ===
# Directory for caching yfinance data
DATA_CACHE_DIR=data_cache

# === Agent Configuration ===
# Maximum pair retry attempts before giving up
MAX_PAIR_ATTEMPTS=5

# Fast parsing and screening model
GEMINI_FAST_MODEL=gemini-3.8-flash
FAST_LLM_MODEL=gemini-3.8-flash

# High-reasoning verification and reporting model
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
REASONING_LLM_MODEL=gemini-3.1-pro-preview

# Fundamentals data path (optional override)
FUNDAMENTALS_CSV_PATH=data/fundamentals.csv

# === Hosted Platform: Supabase & Razorpay ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
FREE_TIER_DAILY_RUNS=3
