# Market-Neutral Hedge Builder - Environment Variables
# Copy this file to .env and fill in your API keys

# === LLM API Keys ===
# Google Gemini API Key (required for agent orchestration)
GOOGLE_API_KEY=your_google_api_key_here

# === Optional: News & Sentiment ===
# Tavily API Key (optional, for news catalyst guardrail)
TAVILY_API_KEY=your_tavily_api_key_here

# === Market Configuration ===
# Risk-free rate for India (RBI 10Y Bond Yield, default 6.8%)
RISK_FREE_RATE=0.068

# Default benchmark index
DEFAULT_BENCHMARK=^NSEI

# Default capital in INR
DEFAULT_CAPITAL=100000

# === Cache Configuration ===
# Directory for caching yfinance data
DATA_CACHE_DIR=data_cache

# === Agent Configuration ===
# Maximum pair retry attempts before giving up
MAX_PAIR_ATTEMPTS=5

# LLM model for fast parsing
FAST_LLM_MODEL=gemini-2.5-flash

# LLM model for reasoning/reporting
REASONING_LLM_MODEL=gemini-2.5-pro
